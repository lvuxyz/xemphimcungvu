# Base URL của KKPhim public API (§3). Không cần API key.
NEXT_PUBLIC_API_BASE_URL=https://phimapi.com

# CDN ảnh mặc định — dùng khi response không trả APP_DOMAIN_CDN_IMAGE (§4.2)
NEXT_PUBLIC_IMAGE_CDN=https://phimimg.com

# Proxy ảnh /image.php của KKPhim hiện trả 404 — để trống hoặc false (xem README)
NEXT_PUBLIC_USE_IMAGE_PROXY=false

# Bật @next/bundle-analyzer: ANALYZE=true npm run build
# ANALYZE=false
